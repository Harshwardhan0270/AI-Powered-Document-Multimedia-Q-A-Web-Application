# ── AI Provider ──────────────────────────────────────────────
# Use "groq" (FREE) or "openai" (paid)
AI_PROVIDER=groq

# Groq - FREE at https://console.groq.com  (sign up → API Keys → Create)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI - only needed if AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── App ───────────────────────────────────────────────────────
SECRET_KEY=supersecretkey-change-in-production-abc123xyz
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/qaapp
REDIS_URL=redis://redis:6379/0
DEBUG=false
UPLOAD_DIR=/app/uploads
FAISS_INDEX_DIR=/app/faiss_indexes
MAX_FILE_SIZE_MB=100
ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:3000","http://localhost"]
